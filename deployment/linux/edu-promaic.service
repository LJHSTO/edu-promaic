[Unit]
Description=Edu ProMAIC protected classroom
After=network.target

[Service]
Type=exec
User=edu-promaic
Group=edu-promaic
UMask=0077
WorkingDirectory=/opt/edu-promaic/current
StateDirectory=edu-promaic
StateDirectoryMode=0700
Environment=NODE_ENV=production
Environment=CLASSROOM_PROFILE=protected
Environment=CLASSROOM_SECURITY_CONFIG=/etc/edu-promaic/classroom.json
Environment=CLASSROOM_STORE_KEY_FILE=%d/store-key
Environment=CLASSROOM_AUDIT_KEY_FILE=%d/audit-key
Environment=HOST=127.0.0.1
Environment=PORT=3443
LoadCredential=store-key:/etc/edu-promaic/credentials/store-key
LoadCredential=audit-key:/etc/edu-promaic/credentials/audit-key
LoadCredential=tls-private.pem:/etc/edu-promaic/credentials/tls-private.pem
ExecStart=/usr/bin/node code/backend/server.js
Restart=on-failure
RestartSec=5s
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
