{
  "name": "edu-promaic",
  "version": "0.1.0",
  "description": "Edu ProMAIC: 面向大学新生微积分课堂的主动学习 Agent 系统",
  "main": "code/core_engine/index.js",
  "scripts": {
    "start": "node code/backend/server.js",
